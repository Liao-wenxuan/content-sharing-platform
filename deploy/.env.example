# 复制成 deploy/.env（这个文件被 .gitignore 排除，永远不要提交真值）
#   cp deploy/.env.example deploy/.env
#
# 分两组：
#   A. 发布机（你的笔记本）读 —— deploy.sh / Caddyfile 用
#   B. 服务器读 —— pm2 / Express 用，需要 `set -a; . deploy/.env; set +a` 注入
# 两组放在同一个文件里，是因为换台机器复现时只需要带一份东西。

# ===== A. 发布目标 =====
# deploy.sh 用 ssh/scp，走的是普通 SSH 密钥，不需要密码。
DEPLOY_HOST=deploy@your-host.example.com
DEPLOY_DIR=/srv/csp/repo
DEPLOY_SSH_KEY=
# 留空 = 用 ssh 默认密钥；写绝对路径可指定（Windows 上用 ~/.ssh/id_ed25519 这种形式）

# ===== Caddy 站点块（在服务器上导出后合并进 /etc/caddy/Caddyfile）=====
CSP_DOMAIN=csp.example.com
CSP_WEB_ROOT=/srv/csp/repo/client/dist

# ===== B. 运行时 =====
# ⚠️ 生产环境必填，用 `openssl rand -hex 32` 生成。
# server/src/lib/env.ts 会在启动期校验：没有它，进程直接起不来（故意的）。
JWT_SECRET=
NODE_ENV=production
PORT=3000
TOKEN_EXPIRES_IN=7d

# SQLite 是文件，必须放在 repo 之外：发布时 dist 会被整个原子替换，
# 数据库和上传文件不在替换范围内。目录要先建好并给 deploy 用户写权限。
CSP_DATA_DIR=/srv/csp/data
DB_PATH=/srv/csp/data/app.db

# 前面挂了一层反代就设 1；直跑（无代理）留空。
TRUST_PROXY=1

# 站内 AI 问答默认不接模型也能跑（离线确定性答案）。
# 想接 OpenAI 兼容的流式生成再填这三个，留空不影响任何功能。
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
