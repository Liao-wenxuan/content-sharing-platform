# Node
node_modules/
**/node_modules/
# 构建产物
dist/
**/dist/
# 测试覆盖率报告（npm run test:coverage 生成，纯产物不入库）
coverage/
**/coverage/
# 数据库文件（SQLite 数据是运行时生成的）
*.db
*.db-journal
*.db.bak
*.db-shm
*.db-wal
# 环境变量
.env
.env.local
!.env.example
# 日志
*.log
logs/
# 编辑器
.vscode/
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
# 系统
desktop.ini
NUL
/data.db
# 截图（开发时的临时视觉记录，不入版本库）
screenshots/
**/screenshots/
shots/
**/shots/
# 但 README 用的正式截图要入库
!docs/screenshots/
!docs/screenshots/**
# 用户上传文件（运行时生成，不入版本库）
uploads/
**/uploads/
