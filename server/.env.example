# ===== 运行环境 =====
# development | production | test
NODE_ENV=development

# ===== 服务端口 =====
PORT=3000

# ===== JWT 密钥 =====
# ⚠️ 生产环境必须改：用 `openssl rand -hex 32` 生成强随机串
# 长度建议 ≥32 字符。dev 可以用下面的默认值，但**永远不要**在生产用这个值。
JWT_SECRET=dev-secret-please-change-in-prod

# ===== JWT 有效期 =====
# jsonwebtoken 支持：'7d', '24h', '60m', 数字（秒）等
TOKEN_EXPIRES_IN=7d

# ===== CORS 白名单 =====
# 多个 origin 用英文逗号分隔，例如：https://a.com,https://b.com
# '*' = 允许所有（仅 dev 用）
CORS_ORIGINS=*
