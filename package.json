{
  "name": "content-sharing-platform-root",
  "private": true,
  "version": "0.1.0",
  "description": "Root-level tooling: lint, format, git hooks. Client + server each have their own package.json for runtime deps.",
  "scripts": {
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,css}\"",
    "test:e2e": "node scripts/desktop-smoke.mjs",
    "test:search": "node scripts/search-smoke.mjs",
    "test:center": "node scripts/center-audit.mjs",
    "screenshot": "node scripts/screenshot-docs.mjs",
    "seed": "node server/seed.mjs",
    "seed:clean": "node server/cleanup-test-data.mjs",
    "seed:photos": "node scripts/fetch-demo-photos.mjs",
    "prepare": "husky",
    "test:client": "npm --prefix client test",
    "test:chat": "node scripts/chat-smoke.mjs",
    "test:follow": "node scripts/follow-smoke.mjs",
    "test:favorite": "node scripts/favorite-smoke.mjs",
    "test:notify": "node scripts/notification-smoke.mjs",
    "test:topic": "node scripts/topic-smoke.mjs",
    "test:comment": "node scripts/comment-smoke.mjs",
    "test:history": "node scripts/view-history-smoke.mjs",
    "test:motion": "node scripts/motion-check.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "vue-eslint-parser": "^9.4.3"
  }
}
